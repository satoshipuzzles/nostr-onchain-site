{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [{"type": "host", "value": "pocketsigner.com"}],
      "destination": "/pocket-signer",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{"type": "host", "value": "www.pocketsigner.com"}],
      "destination": "/pocket-signer",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Referrer-Policy", "value": "no-referrer"}
      ]
    }
  ]
}
